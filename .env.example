# Supabase project the app talks to. Only the URL and the *publishable* key belong
# here; never put a service-role / sb_secret_ key in a VITE_ variable (it ships to the browser).
#
# `.env` is managed by Lovable Cloud and points at the Lovable-hosted project.
# To run locally against your own Supabase project, copy this file to `.env.local`
# (git-ignored via *.local; Vite gives it priority over `.env`) and fill it in from
# Supabase Dashboard -> Project Settings -> API Keys / Data API.
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# Same values, read by server-side code (SSR / server functions).
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_PROJECT_ID="<project-ref>"
